# Configuração do Inventário de TI.
# Copie este arquivo para .env.local e preencha os valores.
# O .env.local fica só no seu computador: ele não vai para o GitHub.

# Endereço do banco de dados (Postgres no Neon).
# No painel do Neon, clique em "Connect" e copie o endereço que começa com postgresql://
DATABASE_URL=

# Só para os testes de navegador (npm run test:e2e): um banco SEPARADO,
# que é apagado a cada rodada. Nunca use aqui o mesmo endereço de cima.
# E2E_DATABASE_URL=
